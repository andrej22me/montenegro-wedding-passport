# Leave the Google vars empty to use data/rsvp-mock.json.
# When all three are set, RSVP reads and writes the Google Sheet instead.
# Sheets: Responses and Flights.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
RSVP_SHEET_ID=

# Public site origin used in the details link. No trailing slash.
SITE_URL=http://localhost:3456

# Leave the Resend vars empty to print confirmation emails in the server log.
RESEND_API_KEY=
RESEND_FROM=

# Required by the daily flight-reminder cron.
CRON_SECRET=
